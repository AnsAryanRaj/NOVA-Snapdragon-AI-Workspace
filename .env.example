# NOVA Workspace Assistant Environment Configuration

# Project Metadata
PROJECT_NAME="NOVA Workspace Assistant"
VERSION="0.1.0"
ENVIRONMENT="development"

# Security & Privacy Policy Settings
PRIVACY_MODE="offline-strict"
UNRESTRICTED_SHELL_ALLOWED=false
CONFIRMATION_REQUIRED_DEFAULT=true
AUDIT_LOG_ENABLED=true

# Database
DATABASE_URL="sqlite:///./nova_workspace.db"

# Server
PORT=8000
HOST="127.0.0.1"
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
